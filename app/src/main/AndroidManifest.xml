<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- StudioSnap has NO INTERNET permission. Capture stays on the device. ML Kit's usage
         logging library (com.google.android.datatransport) merges INTERNET in; remove it. Its
         uploads then just fail, and OCR runs on the bundled model. ACCESS_NETWORK_STATE, which it
         also adds, stays: it can't send anything, and Android 14+ requires it for the network
         constraint on the library's upload job (without it that schedule() call throws). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Only used when you turn on the mic or system-audio toggle for a recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Only used for the camera bubble, when you turn it on in Record mode. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudioSnap">

        <!-- Home / Library (Phase 0 placeholder) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "StudioSnap Capture": one-tap trampoline that opens the bar -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity-alias
            android:name=".CaptureLauncher"
            android:targetActivity=".CaptureActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/capture_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The always-ready capture service -->
        <service
            android:name=".service.SnapService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- adb-only test hooks (shell holds DUMP) -->
        <receiver
            android:name=".util.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.kuscher.studiosnap.DEBUG" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="StudioSnap Settings" />

        <activity
            android:name=".StudioActivity"
            android:exported="true"
            android:label="StudioSnap Editor"
            android:taskAffinity="io.github.kuscher.studiosnap.editor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- "StudioSnap Editor": open the annotation editor standalone (empty canvas + Open) -->
        <activity-alias
            android:name=".EditorLauncher"
            android:targetActivity=".StudioActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="StudioSnap Editor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".RecordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Asks for a runtime permission when a Record-mode toggle needs one -->
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".record.RecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
